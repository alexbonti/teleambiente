# dependencies
node_modules/
.pnpm-store/

# build output
.next/
out/
dist/
coverage/

# local caches (the sandbox forbids writing outside the workspace, so npm/pnpm
# caches live here — see .npmrc)
.cache/
.npm/

# env & secrets
.env
.env.*
!.env.example

# Next.js generates this on dev/build; its import path flips between .next/dev/types
# and .next/types, so tracking it only creates churn.
app/next-env.d.ts

# tooling state
.impeccable/config.local.json
.vercel/

# os
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo

# Static export for the GitHub Pages preview (generated by the pages workflow)
app/out/
app/public/search-index.json
