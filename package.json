{
  "name": "teleambiente",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "start": "pnpm --filter app start",
    "typecheck": "pnpm --filter app typecheck",
    "test": "pnpm --filter app test",
    "lint": "pnpm --filter app lint",
    "audit:crawl": "node scripts/audit/crawl.mjs",
    "audit:weight": "node scripts/audit/weight.mjs",
    "audit:all": "node scripts/audit/crawl.mjs && node scripts/audit/weight.mjs"
  }
}
